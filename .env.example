# ATP Oracle - environment variables
# Copy this file to .env and fill in your own values.

# Groq API key — used by the natural-language agent (get it from https://console.groq.com)
GROQ_API_KEY=

# Optional overrides (see config/settings.py for the full list)
# ATP_HDFS_NAMENODE_URL=http://localhost:9870
# ATP_AGENT_GROQ_MODEL=openai/gpt-oss-120b

# Storage backend: "s3" (AWS bucket) or "local" (files under ATP_STORAGE_LOCAL_ROOT)
# ATP_STORAGE_BACKEND=local
# Required when the backend is "s3"
# ATP_S3_BUCKET=your-bucket-name
# ATP_STORAGE_LOCAL_ROOT=.cache/storage
# Sackmann dataset: URL or local folder with the tennis_atp CSVs
# ATP_SCRAPER_SACKMANN_SOURCE=/path/to/tennis_atp
